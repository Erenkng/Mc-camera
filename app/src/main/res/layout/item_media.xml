<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_margin="4dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/mediaImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_dim"
        android:contentDescription="@string/gallery_title"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeMedia" />

    <ImageView
        android:id="@+id/mediaVideoBadge"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="6dp"
        android:contentDescription="@string/mode_video"
        android:src="@drawable/ic_play_badge"
        android:visibility="gone" />

</FrameLayout>
