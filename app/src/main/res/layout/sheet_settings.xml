<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/SheetHeading"
            android:layout_marginTop="0dp"
            android:text="@string/section_look" />


        <LinearLayout style="@style/SheetRow">

            <TextView
                style="@style/SheetLabel"
                android:text="@string/density_title" />

            <TextView
                android:id="@+id/densityValue"
                style="@style/SheetValue" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/densitySlider"
            style="@style/SheetSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/SheetHint"
            android:text="@string/density_hint" />

        <!-- Style -->
        <TextView
            style="@style/SheetHeading"
            android:text="@string/section_style" />

        <LinearLayout style="@style/SheetRow">

            <TextView
                style="@style/SheetLabel"
                android:text="@string/shade_title" />

            <TextView
                android:id="@+id/shadeValue"
                style="@style/SheetValue" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/shadeSlider"
            style="@style/SheetSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout style="@style/SheetRow">

            <TextView
                style="@style/SheetLabel"
                android:text="@string/dither_title" />

            <TextView
                android:id="@+id/ditherValue"
                style="@style/SheetValue" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/ditherSlider"
            style="@style/SheetSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/SheetHint"
            android:text="@string/dither_hint" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/bevelSwitch"
            style="@style/SheetSwitch"
            android:text="@string/bevel_title" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/outlineSwitch"
            style="@style/SheetSwitch"
            android:text="@string/outline_title" />

        <!-- Colour -->
        <TextView
            style="@style/SheetHeading"
            android:text="@string/section_colour" />

        <TextView
            style="@style/SheetLabelBlock"
            android:text="@string/brightness" />

        <com.google.android.material.slider.Slider
            android:id="@+id/brightnessSlider"
            style="@style/SheetSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/SheetLabelBlock"
            android:text="@string/contrast" />

        <com.google.android.material.slider.Slider
            android:id="@+id/contrastSlider"
            style="@style/SheetSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/SheetLabelBlock"
            android:text="@string/saturation" />

        <com.google.android.material.slider.Slider
            android:id="@+id/saturationSlider"
            style="@style/SheetSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetColour"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset_colour" />

        <!-- Output -->
        <TextView
            style="@style/SheetHeading"
            android:text="@string/section_output" />

        <TextView
            style="@style/SheetLabelBlock"
            android:text="@string/photo_detail" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/photoGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/photoScreen"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/photo_screen" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/photoHigh"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/photo_high" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/photoMax"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/photo_max" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            style="@style/SheetHint"
            android:text="@string/photo_detail_hint" />

        <TextView
            style="@style/SheetLabelBlock"
            android:text="@string/video_quality" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/videoGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/video720"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/video_720" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/video1080"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/video_1080" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Packs -->
        <TextView
            style="@style/SheetHeading"
            android:text="@string/section_packs" />

        <LinearLayout style="@style/SheetRow">

            <TextView
                style="@style/SheetLabel"
                android:text="@string/block_limit" />

            <TextView
                android:id="@+id/blockLimitValue"
                style="@style/SheetValue" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/blockLimitSlider"
            style="@style/SheetSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/SheetHint"
            android:text="@string/block_limit_hint" />

        <LinearLayout
            android:id="@+id/packList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/importPack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/import_pack" />

        <TextView
            style="@style/SheetHint"
            android:text="@string/pack_hint" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
